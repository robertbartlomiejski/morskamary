+    "budget",
+    "budget_sha256",
+    "counters",
+    "stop_reasons",
+    "status",
+    "reservations",
+    "refusals",
+    "infrastructure_traffic",
+)
+_AUDIT_FORBIDDEN_FRAGMENTS = (
+    "authorization",
+    "bearer ",
+    "api_key",
+    "apikey",
+    "x-els-apikey",
+    "client_secret",
+    "password",
+    "/home/",
+    "/tmp/",
+    "/runner/",
+    "/users/",
+    "c:\\",
+)
+
+
+def verify_audit_file(path: str | os.PathLike[str]) -> List[str]:
+    """Return problems with a written audit; an empty list means it is publishable."""
+    try:
+        text = Path(path).read_text(encoding="utf-8")
+        payload = json.loads(text)
+    except (OSError, json.JSONDecodeError):
+        return ["audit file is missing or is not valid JSON"]
+    problems: List[str] = []
+    if not isinstance(payload, dict):
+        return ["audit must be a JSON object"]
+    if payload.get("schema_version") != AUDIT_SCHEMA_VERSION:
+        problems.append("audit schema_version mismatch")
+    for key in _AUDIT_REQUIRED_KEYS:
+        if key not in payload:
+            problems.append(f"audit is missing {key}")
+    lowered = text.lower()
+    for fragment in _AUDIT_FORBIDDEN_FRAGMENTS:
+        if fragment in lowered:
+            problems.append(f"audit contains forbidden content: {fragment.strip()}")
+    return problems
