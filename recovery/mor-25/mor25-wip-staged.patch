@@ -0,0 +1,87 @@
+"""Strictly scoped GitHub infrastructure fetch, outside the provider budget.
+
+Retained protocol commits may need to be fetched from the repository's own
+GitHub ``origin`` (shallow CI checkouts). That is repository infrastructure
+traffic, not scientific-provider traffic, so it is not counted in the physical
+attempt budget. The exemption is deliberately narrow and is the only
+network-capable subprocess route the route scanner accepts:
+
+* the commit must be a full 40-character lowercase hexadecimal object id;
+* ``origin`` must be an ``https://github.com/<owner>/<repo>`` URL;
+* the argument vector is fixed, uses no shell and no user-supplied options;
+* every fetch is logged with the origin host and a shortened commit id.
+
+Any other ``git``/``curl``/``wget`` network route is reported by
+``find_ungoverned_network_routes``.
+"""
+from __future__ import annotations
+
+import logging
+import re
+import subprocess
+from pathlib import Path
+
+LOGGER = logging.getLogger(__name__)
+
+COMMIT_RE = re.compile(r"^[0-9a-f]{40}$")
+GITHUB_ORIGIN_RE = re.compile(
+    r"^https://github\.com/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+?(\.git)?/?$"
+)
+INFRASTRUCTURE_FETCH_POLICY = {
+    "traffic_class": "infrastructure",
+    "counted_in_physical_attempt_budget": False,
+    "allowed_origin": "https://github.com/<owner>/<repo>",
+    "allowed_object": "40-character lowercase hexadecimal commit id",
+    "module": "src/infrastructure_git.py",
+    "function": "fetch_github_commit",
+}
+
+
+class InfrastructureFetchError(RuntimeError):
+    """Raised before any network access when a fetch request is not allowed."""
+
+
+def validate_commit(commit: str) -> str:
+    if not isinstance(commit, str) or not COMMIT_RE.fullmatch(commit):
+        raise InfrastructureFetchError(
+            "infrastructure fetch requires a full 40-character lowercase commit id"
+        )
+    return commit
+
+
+def validate_origin_url(url: str) -> str:
+    if not isinstance(url, str) or not GITHUB_ORIGIN_RE.fullmatch(url.strip()):
+        raise InfrastructureFetchError(
+            "infrastructure fetch is limited to an https://github.com/ origin"
+        )
+    return url.strip()
+
+
+def fetch_github_commit(repo_root: Path, commit: str) -> subprocess.CompletedProcess[str]:
+    """Fetch one validated commit from the GitHub ``origin`` of ``repo_root``."""
+    validate_commit(commit)
+    remote = subprocess.run(
+        ["git", "-C", str(repo_root), "remote", "get-url", "origin"],
+        check=False,
+        capture_output=True,
+        text=True,
+    )
+    if remote.returncode != 0:
+        raise InfrastructureFetchError("origin remote is not configured")
+    validate_origin_url(remote.stdout)
+    LOGGER.info("[INFO] infrastructure git fetch from github.com origin: %s", commit[:12])
+    return subprocess.run(
+        [
+            "git",
+            "-C",
+            str(repo_root),
+            "fetch",
+            "--no-tags",
+            "--filter=blob:none",
+            "origin",
+            commit,
+        ],
+        check=False,
+        capture_output=True,
+        text=True,
+    )
