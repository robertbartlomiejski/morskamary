{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://morskamary.local/schemas/sector_competence_assignments.schema.json",
  "title": "Sector competence assignments row",
  "type": "object",
  "required": [
    "assignment_id",
    "canonical_competence_id",
    "validation_decision_id",
    "source_candidate_id",
    "sector",
    "axis_group",
    "axis_code",
    "evidence_ids"
  ],
  "additionalProperties": false,
  "properties": {
    "assignment_id": { "type": "string", "minLength": 1 },
    "canonical_competence_id": { "type": "string", "minLength": 1 },
    "validation_decision_id": { "type": "string", "minLength": 1 },
    "source_candidate_id": { "type": "string", "minLength": 1 },
    "sector": { "type": "string" },
    "axis_group": {
      "type": "string",
      "enum": ["MARINE", "MARITIME", "OCEANIC", "HYDRONIZATION"]
    },
    "axis_code": { "type": "string", "enum": ["M", "T", "O", "H"] },
    "evidence_ids": { "type": "string", "minLength": 1 }
  },
  "allOf": [
    {
      "anyOf": [
        { "properties": { "axis_group": { "const": "MARINE" }, "axis_code": { "const": "M" } } },
        { "properties": { "axis_group": { "const": "MARITIME" }, "axis_code": { "const": "T" } } },
        { "properties": { "axis_group": { "const": "OCEANIC" }, "axis_code": { "const": "O" } } },
        { "properties": { "axis_group": { "const": "HYDRONIZATION" }, "axis_code": { "const": "H" } } }
      ]
    }
  ]
}
